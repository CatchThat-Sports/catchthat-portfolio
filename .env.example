# Public site phase: teaser (default) or release.
NEXT_PUBLIC_SITE_PHASE=teaser
# Server-side preview gate. Set true to open /game and its child routes before release.
RELEASE_PREVIEW_ENABLED=false
# Local development uses https://resolute-raccoon-990.convex.cloud.
# Production (Vercel) uses https://fantastic-crocodile-127.convex.cloud.
# Only the Cloud URL is used by the site; the .convex.site HTTP Actions URL is not needed.
CONVEX_DEPLOYMENT=dev:resolute-raccoon-990
NEXT_PUBLIC_CONVEX_URL=
# Server-only value. Must match CONVEX_SITE_SECRET in the selected Convex deployment.
CONVEX_SITE_SECRET=
# Resend delivery is off until this is true on the server. Keep the key server-only.
RESEND_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL="Sam <sause@catchthat.io>"
# Public origin used for the unsubscribe link in welcome mail.
SITE_PUBLIC_URL=https://catchthat.io
# Set once the Steam page is live; until then the site says "Steam page coming soon".
NEXT_PUBLIC_STEAM_URL=
